{
  "framework": "fastapi",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix src/frontend",
  "installCommand": "python -m pip install -r requirements.txt && npm install --prefix src/frontend",
  "outputDirectory": "src/frontend/dist",
  "functions": {
    "src/api/index.py": {
      "includeFiles": "src/{backend/app,frontend/dist}/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|health$).*)",
      "destination": "/index.html"
    }
  ]
}
